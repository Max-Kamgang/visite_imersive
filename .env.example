# ── Supabase (backend MUSÉA) ──
# Clé PUBLIABLE (sûre côté frontend). À récupérer dans Supabase > Project Settings > API.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# ── Proxy IA (optionnel) ──
# La clé API IA ne doit JAMAIS être dans le frontend : elle reste côté serveur.
# Vide = fallback mock local pour les fonctions IA de l'ERP.
VITE_AI_API_BASE=

# ── Synthèse vocale (assistant vocal) ──
# 'browser' (défaut) = voix du navigateur, gratuit, sans clé.
# 'elevenlabs' = voix IA cloud via l'Edge Function `tts` (la clé ELEVENLABS_API_KEY
# se pose côté Supabase, JAMAIS ici). Voir ELEVENLABS_TTS_SETUP.md.
VITE_TTS_PROVIDER=browser
